package dispatch:guest@2.0.0;

interface handler {
  record request {
    method: string,
    path: string,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  record response {
    status: s32,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }
  
  handle: func(req: request) -> response;
}

world dispatch {
  export handler;
}